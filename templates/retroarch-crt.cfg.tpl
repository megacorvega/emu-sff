# This profile is intentionally small and auditable.
# It assumes the desktop session is already running on a 15 kHz super
# resolution and RetroArch should simply use it fullscreen.

video_fullscreen = "true"
video_windowed_fullscreen = "false"
video_vsync = "true"
video_hard_sync = "true"
video_scale_integer = "true"
video_shader_enable = "false"
video_refresh_rate = "60.000000"
video_fullscreen_x = "__SUPER_WIDTH__"
video_fullscreen_y = "__SUPER_HEIGHT__"
crt_switch_resolution = "true"
aspect_ratio_index = "22"
